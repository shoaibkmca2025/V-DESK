  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": "https://vdeskworkspace.com/#organization",
        "name": "V-DESK Workspace & Consulting LLP",
        "url": "https://vdeskworkspace.com",
        "logo": "https://vdeskworkspace.com/assets/vdesk-logo.svg",
        "image": "https://vdeskworkspace.com/assets/vdesk-logo.svg",
        "telephone": "+919876543210",
        "priceRange": "&#8377;&#8377;",
        "description": "India's premier business infrastructure platform &mdash; Virtual Offices, Coworking, Meeting Rooms & Business Registration.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "V-DESK Corporate Tower, College Road",
          "addressLocality": "Nashik",
          "addressRegion": "Maharashtra",
          "postalCode": "422005",
          "addressCountry": "IN"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "2400"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://vdeskworkspace.com/#faqs",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is a Virtual Office 100% legal for GST and Company Registration in India?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, absolutely. Under the CGST Act 2017 and MCA SPICe+ rules, a business is fully permitted to operate from a commercial address provided they hold a registered commercial rent agreement, owner NOC, and a recent electricity bill copy. V-DESK provides all verified documents."
            }
          },
          {
            "@type": "Question",
            "name": "How quickly can V-DESK activate my Virtual Office address?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Upon submission of basic KYC documents (PAN, Aadhaar, photo), V-DESK delivers your notarized rent agreement, landlord NOC, and electricity bill within 24 working hours."
            }
          }
        ]
      }
    ]
  }
  </script>
