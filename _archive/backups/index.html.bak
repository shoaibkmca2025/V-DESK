            <span>4K-Enabled Boardrooms</span>
          </div>
          <div class="finder__card-cta">
            <button class="btn btn--primary btn--sm">Find Workspace &rarr;</button>
          </div>
        </div>

        <div class="finder__card" onclick="scrollToSection('#locations')">
          <div class="finder__card-icon"><i class="ph-bold ph-chart-line-up"></i></div>
          <div class="finder__card-label">Expand</div>
          <div class="finder__card-title">Enter a new city</div>
          <div class="finder__card-desc">Establish presence in 10+ major metros with zero capital expenditure.</div>
          <div class="finder__card-services">
            <span>Multi-City Virtual Office</span>
            <span>Multi-State GST (APOB)</span>
            <span>Nationwide Boardrooms</span>
          </div>
          <div class="finder__card-cta">
            <button class="btn btn--primary btn--sm">Explore Hubs &rarr;</button>
          </div>
        </div>
      </div>

      <!-- Interactive Discovery Filter Engine -->
      <div class="discovery-filter-engine reveal" id="discoveryFilterEngine">
        <div class="discovery-filter-bar">
          <div class="filter-group">
            <label class="filter-label" for="discCity"><i class="ph-bold ph-map-pin"></i> City</label>
            <select id="discCity" class="filter-select" onchange="filterDiscoveryEngine()">
              <option value="all">All Cities (10+)</option>
              <option value="Nashik">Nashik (Flagship)</option>
              <option value="Mumbai">Mumbai</option>
              <option value="Delhi">Delhi NCR</option>
              <option value="Bangalore">Bangalore</option>
              <option value="Pune">Pune</option>
              <option value="Hyderabad">Hyderabad</option>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="discType"><i class="ph-bold ph-buildings"></i> Workspace Type</label>
            <select id="discType" class="filter-select" onchange="filterDiscoveryEngine()">
              <option value="all">All Workspaces</option>
              <option value="Virtual Office">Virtual Office</option>
              <option value="Coworking">Coworking Desk</option>
              <option value="Private Office">Private Cabin</option>
              <option value="Meeting Rooms">Meeting Room</option>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="discTeam"><i class="ph-bold ph-users-three"></i> Team Size</label>
            <select id="discTeam" class="filter-select" onchange="filterDiscoveryEngine()">
              <option value="all">Any Team Size</option>
              <option value="solo">1&mdash;2 Solo / Founders</option>
              <option value="growth">3&mdash;8 Growth Team</option>
              <option value="team">9&mdash;20 Enterprise</option>
              <option value="large">20+ Custom Suite</option>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="discDuration"><i class="ph-bold ph-calendar"></i> Duration</label>
            <select id="discDuration" class="filter-select" onchange="filterDiscoveryEngine()">
              <option value="all">Flexible</option>
              <option value="daily">Hourly / Daily</option>
              <option value="monthly">Monthly</option>
              <option value="annual">Annual (Save 20%)</option>
            </select>
          </div>

          <div class="filter-group filter-group--btn">
            <button class="btn btn--primary btn--full" onclick="filterDiscoveryEngine()">
              <i class="ph-bold ph-funnel"></i> Apply Filter
            </button>
          </div>
        </div>

        <!-- Dynamic Discovery Results Grid -->
        <div class="discovery-results-grid" id="discoveryResultsContainer">
          <!-- Rendered dynamically by app.js filterDiscoveryEngine() -->
        </div>
      </div>

    </div>
  </section>

  <!-- ====================================================================
       SECTION: REQUIRED KYC DOCUMENTS (ECHOSPACES REFERENCE)
       ==================================================================== -->
  <section class="kyc-section" id="kycDocs">
    <div class="container">
      <div class="section__header section__header--center reveal">
        <span class="section__eyebrow" style="color: var(--vd-teal-primary);"><i class="ph-bold ph-file-text"></i> Transparent Compliance</span>
        <h2 class="section__title">REQUIRED KYC <span class="highlight-gold">DOCUMENTS</span></h2>
        <p class="section__desc">Clear, paperless checklist required for fast registration, agreement execution, and 100% approval by tax officers.</p>
      </div>

      <!-- Tab Buttons -->
      <div class="kyc-tabs-nav reveal">
        <button type="button" class="kyc-tab-btn active" onclick="switchKycTab('individual', this)">
          <i class="ph-bold ph-user"></i> Sole Proprietor / Individual
        </button>
        <button type="button" class="kyc-tab-btn" onclick="switchKycTab('partnership', this)">
          <i class="ph-bold ph-users-three"></i> LLP &amp; Partnership Firms
        </button>
        <button type="button" class="kyc-tab-btn" onclick="switchKycTab('company', this)">
          <i class="ph-bold ph-buildings"></i> Company (Pvt Ltd, OPC, Public)
        </button>
      </div>

      <!-- Tab Panes -->
      <div class="kyc-panes-container">
        <!-- Pane 1: Individual -->
        <div class="kyc-pane active" id="kycPaneIndividual">
          <div class="kyc-doc-list">
            <div class="kyc-doc-item">
              <i class="ph-bold ph-identification-card kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>PAN Card Copy</strong>
                <span>Self-attested copy of applicant / proprietor's permanent account number card.</span>
              </div>
            </div>
            <div class="kyc-doc-item">
              <i class="ph-bold ph-address-book kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>Aadhaar Card / Passport Copy</strong>
                <span>Valid photo identification and residential address proof of the proprietor.</span>
              </div>
            </div>
            <div class="kyc-doc-item">
              <i class="ph-bold ph-image kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>Passport Size Photograph</strong>
                <span>Recent color digital photo of the business applicant.</span>
              </div>
            </div>
            <div class="kyc-doc-item">
              <i class="ph-bold ph-bank kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>Bank Proof / Cancelled Cheque</strong>
                <span>Copy of cancelled cheque or passbook front page for bank verification.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Pane 2: Partnership / LLP -->
        <div class="kyc-pane" id="kycPanePartnership">
          <div class="kyc-doc-list">
            <div class="kyc-doc-item">
              <i class="ph-bold ph-users kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>PAN &amp; Aadhaar of All Partners</strong>
                <span>Self-attested identity and address proof copies for each designated partner.</span>
              </div>
            </div>
            <div class="kyc-doc-item">
              <i class="ph-bold ph-certificate kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>Firm Registration / LLP Agreement</strong>
                <span>Certificate of Incorporation (COI for LLP) or notarized Partnership Deed.</span>
              </div>
            </div>
            <div class="kyc-doc-item">
              <i class="ph-bold ph-files kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>Entity PAN Card</strong>
                <span>Copy of the official PAN card issued in the name of the LLP / Firm.</span>
              </div>
            </div>
            <div class="kyc-doc-item">
              <i class="ph-bold ph-bank kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>Bank Account Proof</strong>
                <span>Firm's current account cancelled cheque or bank statement copy.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Pane 3: Company -->
        <div class="kyc-pane" id="kycPaneCompany">
          <div class="kyc-doc-list">
            <div class="kyc-doc-item">
              <i class="ph-bold ph-seal-check kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>Certificate of Incorporation (COI)</strong>
                <span>MCA SPICe+ Incorporation Certificate with CIN (or proposed names for new setup).</span>
              </div>
            </div>
            <div class="kyc-doc-item">
              <i class="ph-bold ph-identification-card kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>Directors' KYC (PAN &amp; Aadhaar)</strong>
                <span>Identity and address verification copies for all appointed Directors / DIN holders.</span>
              </div>
            </div>
            <div class="kyc-doc-item">
              <i class="ph-bold ph-file-text kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>MOA &amp; AOA / Board Resolution</strong>
                <span>Memorandum &amp; Articles of Association and letter of authorization on company letterhead.</span>
              </div>
            </div>
            <div class="kyc-doc-item">
              <i class="ph-bold ph-bank kyc-doc-icon"></i>
              <div class="kyc-doc-content">
                <strong>Company PAN &amp; Bank Cheque</strong>
                <span>Company PAN copy and bank cheque (or initial incorporation documentation for new Pvt Ltd).</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div style="text-align: center; margin-top: 32px;">
        <button class="btn btn--teal btn--md" onclick="openQuoteModal('KYC Document Checklist')">
          <i class="ph-bold ph-download-simple"></i> Download Complete KYC Checklist
        </button>
      </div>
    </div>
  </section>

  <!-- ====================================================================
