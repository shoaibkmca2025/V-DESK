  <div class="modal-overlay" id="quoteModal" onclick="closeModalOnBackdrop(event, 'quoteModal')">
    <div class="modal-card">
      <div class="modal-card__header">
        <h3 class="modal-card__title" id="modalQuoteTitle">Get Your Instant Quote</h3>
        <button class="modal-card__close" onclick="closeModal('quoteModal')">&times;</button>
      </div>
      <p class="modal-card__subtitle">Our business infrastructure specialists will send you an itemized proposal within 15 minutes.</p>
      
      <form id="modalQuoteForm" onsubmit="handleModalQuoteSubmit(event)">
        <div class="form-row-2">
          <div class="form-field">
            <label class="form-label" for="mqName">Full Name *</label>
            <input type="text" id="mqName" class="form-input" placeholder="Your name" required>
          </div>
          <div class="form-field">
            <label class="form-label" for="mqCompany">Company / Brand Name</label>
            <input type="text" id="mqCompany" class="form-input" placeholder="e.g. Acme Tech Solutions">
          </div>
        </div>
        <div class="form-row-2">
          <div class="form-field">
            <label class="form-label" for="mqMobile">Mobile Number *</label>
            <input type="tel" id="mqMobile" name="mobile" class="form-input" placeholder="10-digit mobile" pattern="[0-9]{10}" required>
          </div>
          <div class="form-field">
            <label class="form-label" for="mqEmail">Work Email *</label>
            <input type="email" id="mqEmail" class="form-input" placeholder="name@company.com" required>
          </div>
        </div>
        <div class="form-row-2">
          <div class="form-field">
            <label class="form-label" for="mqCity">Target City</label>
            <select id="mqCity" class="form-select">
              <option value="Nashik">Nashik (Flagship)</option>
              <option value="Mumbai">Mumbai</option>
              <option value="Delhi">Delhi NCR</option>
              <option value="Bangalore">Bangalore</option>
              <option value="Pune">Pune</option>
              <option value="Hyderabad">Hyderabad</option>
              <option value="Noida">Noida</option>
              <option value="Gurgaon">Gurgaon</option>
              <option value="Chennai">Chennai</option>
              <option value="Other">Other Metro</option>
            </select>
          </div>
          <div class="form-field">
            <label class="form-label" for="mqService">Primary Service</label>
            <select id="mqService" class="form-select">
              <option value="Virtual Office">Virtual Office for GST</option>
              <option value="Coworking">Coworking Space</option>
              <option value="Private Office">Private Office Cabin</option>
              <option value="Meeting Rooms">Meeting Room</option>
              <option value="Company Registration">Company Registration</option>
              <option value="GST Registration">GST Registration</option>
            </select>
          </div>
        </div>
        <div class="form-field">
          <label class="form-label" for="mqMessage">Specific Notes</label>
          <textarea id="mqMessage" class="form-textarea" rows="2" placeholder="e.g. We require registered rent agreement in Mumbai BKC within 48 hours..."></textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--block">
          Submit Quote Request <i class="ph-bold ph-paper-plane-tilt"></i>
        </button>
      </form>
    </div>
  </div>

