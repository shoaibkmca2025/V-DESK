        </select>
        <button class="btn btn--outline btn--sm" onclick="exportLeadsToCSV()"><i class="ph-bold ph-download-simple"></i> Export CSV</button>
        <button class="btn btn--secondary btn--sm" onclick="seedSampleLeads()"><i class="ph-bold ph-arrows-clockwise"></i> Seed Demo Data</button>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Lead ID</th>
              <th>Name</th>
              <th>Contact</th>
              <th>City</th>
              <th>Service</th>
              <th>Status</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="adminLeadsTableBody"></tbody>
        </table>
      </div>
    </div>
  </div>

