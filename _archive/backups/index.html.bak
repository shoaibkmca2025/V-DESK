              <div class="hero-trust-item">
                <i class="ph-bold ph-shield-check"></i>
                <div>
                  <strong>100% Verified</strong>
                  <span>Tax &amp; MCA NOC Guarantee</span>
                </div>
              </div>
              <div class="hero-trust-divider"></div>
              <div class="hero-trust-item">
                <i class="ph-bold ph-lightning"></i>
                <div>
                  <strong>Same-Day</strong>
                  <span>Activation &amp; Agreements</span>
                </div>
              </div>
              <div class="hero-trust-divider"></div>
              <div class="hero-trust-item">
                <i class="ph-bold ph-buildings"></i>
                <div>
                  <strong>10+ Cities</strong>
                  <span>50+ Grade-A Hubs</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: High-Conversion Instant Quote & Lead Capture Card (EchoSpaces Style) -->
          <div class="hero-white__showcase">
            <div class="hero-lead-card">
              <div class="hero-lead-card__header">
                <span class="hero-lead-card__tag"><i class="ph-bold ph-lightning"></i> Instant Quote &amp; Proposal</span>
                <h2 class="hero-lead-card__title">Register Your Business Anywhere in India</h2>
                <p class="hero-lead-card__sub">Get verified commercial address for GST &amp; MCA in 24 hours.</p>
              </div>

              <form class="hero-lead-form" id="heroLeadForm" onsubmit="handleHeroLeadSubmit(event)">
                <div class="hero-input-group">
                  <i class="ph-bold ph-user"></i>
                  <input type="text" class="hero-lead-input" id="heroLeadName" name="name" placeholder="Your Full Name" required>
                </div>
                
                <div class="hero-input-group">
                  <i class="ph-bold ph-envelope"></i>
                  <input type="email" class="hero-lead-input" id="heroLeadEmail" name="email" placeholder="Business Email Address" required>
                </div>

                <div class="hero-input-group">
                  <i class="ph-bold ph-phone"></i>
                  <input type="tel" class="hero-lead-input" id="heroLeadPhone" name="phone" placeholder="Phone Number (+91)" pattern="[0-9]{10}" maxlength="10" required>
                </div>

                <div class="hero-input-group">
                  <i class="ph-bold ph-map-pin"></i>
                  <select class="hero-lead-select" id="heroLeadCity" name="city" required>
                    <option value="" disabled selected>Select Preferred City / State</option>
                    <option value="Delhi NCR">Delhi NCR (Delhi, Noida, Gurgaon)</option>
                    <option value="Mumbai">Mumbai &amp; MMR</option>
                    <option value="Bangalore">Bengaluru (Karnataka)</option>
                    <option value="Pune">Pune (Maharashtra)</option>
                    <option value="Hyderabad">Hyderabad (Telangana)</option>
                    <option value="Kolkata">Kolkata (West Bengal)</option>
                    <option value="Chennai">Chennai (Tamil Nadu)</option>
                    <option value="Ahmedabad">Ahmedabad (Gujarat)</option>
                    <option value="Nashik">Nashik (Maharashtra)</option>
                    <option value="Pan-India">Other States &amp; UTs (Pan-India)</option>
                  </select>
                </div>

                <div class="hero-input-group">
                  <i class="ph-bold ph-briefcase"></i>
                  <select class="hero-lead-select" id="heroLeadPlan" name="plan" required>
                    <option value="" disabled selected>Choose Virtual Office Plan</option>
                    <option value="Virtual Office for GST">Virtual Office for GST Registration (From &#8377;999/mo)</option>
                    <option value="Business Registration Plan">Business Registration Plan (From &#8377;999/mo)</option>
                    <option value="Mailing Address Plan">Mailing Address &amp; Mail Handling (From &#8377;799/mo)</option>
                    <option value="Dedicated Desk Plan">Virtual Office with Dedicated Desk (From &#8377;2,999/mo)</option>
                    <option value="Coworking & Meeting Rooms">Coworking Desks &amp; Meeting Rooms</option>
                  </select>
                </div>

                <button type="submit" class="hero-lead-submit" id="heroLeadSubmitBtn">
                  <span>Get Instant Proposal &amp; Rates</span>
                  <i class="ph-bold ph-arrow-right"></i>
                </button>
              </form>

              <div class="hero-lead-footer">
                <span><i class="ph-bold ph-shield-check" style="color: var(--vd-teal-primary);"></i> 100% Tax Compliant</span>
                <span><i class="ph-bold ph-clock" style="color: var(--vd-teal-primary);"></i> 24-Hr SLA</span>
                <span><i class="ph-bold ph-lock" style="color: var(--vd-teal-primary);"></i> Zero Spam</span>
              </div>
            </div>
          </div>

        <div class="hero-rmc__badges">
