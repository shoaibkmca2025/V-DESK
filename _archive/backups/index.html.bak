  <!-- ====================================================================
       SECTION 07 &mdash; PRICING / ROI FINANCIAL CALCULATOR
       Traditional Lease vs. V-DESK Smart Solution Comparison
       ==================================================================== -->
  <section class="section pricing" id="pricing">
    <div class="container">
      <div class="section__header section__header--center reveal">
        <span class="section__eyebrow">Financial Efficiency</span>
        <h2 class="section__title">CALCULATE YOUR<br>OPERATIONAL SAVINGS.</h2>
        <p class="section__desc">See how modern commercial infrastructure saves up to 88% compared to traditional lock-in commercial leases.</p>
      </div>

      <!-- Segmented Billing Tenure Switcher (Linear / Stripe Style) -->
      <div class="pricing-tenure-wrap reveal">
        <div class="pricing-tenure-toggle" role="group" aria-label="Billing Commitment">
          <button type="button" class="tenure-pill active" id="tenureAnnualBtn" onclick="setBillingTenure('annual')">
            <span>Annual Commitment</span>
            <span class="tenure-save-badge">Save 20%</span>
          </button>
          <button type="button" class="tenure-pill" id="tenureFlexibleBtn" onclick="setBillingTenure('flexible')">
            <span>Quarterly / Flexible</span>
          </button>
        </div>
      </div>

      <div class="pricing__layout">
        <!-- Controls -->
        <div class="pricing__controls reveal">
          <div class="pricing__field">
            <div class="pricing__label">
              <span>1. Select Target Commercial Tier</span>
            </div>
            <select id="calcCity" class="pricing__select" onchange="runCostCalculation()">
              <option value="Tier-1 Metro (Mumbai / Delhi / BLR)">Tier-1 Metro (Mumbai / Delhi / Bangalore)</option>
              <option value="Tier-2 Commercial Hub (Pune / Nashik)" selected>Tier-2 Commercial Hub (Pune / Nashik)</option>
              <option value="Tier-3 Emerging Cities">Tier-3 Emerging Commercial Hubs</option>
            </select>
          </div>

          <div class="pricing__field">
            <div class="pricing__label">
              <span>2. Primary Workspace Service</span>
            </div>
            <select id="calcService" class="pricing__select" onchange="runCostCalculation()">
              <option value="Virtual Office for GST" selected>Virtual Office for GST</option>
              <option value="Coworking Dedicated Desks">Coworking Dedicated Desks</option>
              <option value="Private Office Cabin">Private Office Cabin</option>
              <option value="Hybrid Combo">Hybrid Virtual + Workspaces</option>
            </select>
          </div>

          <div class="pricing__field">
            <div class="pricing__label">
              <span>3. Team Capacity</span>
              <span class="pricing__label-badge" id="calcTeamDisplay">5 Members</span>
            </div>
            <div class="pricing__range-wrap">
              <input type="range" id="calcTeamSlider" class="pricing__range" min="1" max="50" value="5" oninput="updateTeamSlider(this.value)">
            </div>
          </div>

          <div class="pricing__field">
            <div class="pricing__label">
              <span>4. Agreement Duration</span>
            </div>
            <select id="calcDuration" class="pricing__select" onchange="runCostCalculation()">
              <option value="12" selected>12 Months (20% Annual Savings)</option>
              <option value="6">6 Months</option>
              <option value="24">24 Months (Long-Term Rate Lock)</option>
            </select>
          </div>

          <div class="pricing__field">
            <div class="pricing__label">
              <span>5. Enterprise Add-ons</span>
            </div>
            <div class="pricing__checkbox-group">
              <label class="pricing__checkbox-label">
                <input type="checkbox" id="calcAddonGST" checked onchange="runCostCalculation()">
                <span>GST Monthly Filing &amp; Senior CA Support</span>
              </label>
              <label class="pricing__checkbox-label">
                <input type="checkbox" id="calcAddonMeeting" onchange="runCostCalculation()">
                <span>Monthly 10-Hour Executive Boardroom Bundle</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Analysis & Savings Summary -->
        <div class="pricing__summary reveal">
          <div class="pricing__summary-kicker">Comparative Cost Breakdown</div>

          <div class="pricing__comparison">
            <div class="pricing__bar">
              <div class="pricing__bar-header">
                <span class="pricing__bar-title">Traditional Commercial Lease (Deposit, Fitouts, Rent)</span>
                <span class="pricing__bar-value" id="tradLeaseVal">&#8377;14,40,000 / yr</span>
              </div>
              <div class="pricing__bar-track">
                <div class="pricing__bar-fill pricing__bar-fill--trad" style="width:100%;"></div>
              </div>
            </div>

            <div class="pricing__bar">
              <div class="pricing__bar-header">
