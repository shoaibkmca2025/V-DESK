    <a href="https://wa.me/919876543210?text=Hi%20V-DESK%20Team,%20I%20am%20interested%20in%20a%20Virtual%20Office%20plan" target="_blank" rel="noopener" class="floating-whatsapp-btn" aria-label="Chat with expert on WhatsApp">
      <i class="ph-bold ph-whatsapp-logo" style="font-size:1.3rem;"></i>
      <span>WhatsApp Us</span>
    </a>
    <button class="floating-callback-btn" onclick="openQuoteModal('Floating Dock - Quick Callback')" aria-label="Request Instant Callback">
      <i class="ph-bold ph-phone-call" style="font-size:1.15rem; color:var(--vd-teal-light);"></i>
      <span>Request Callback</span>
    </button>
  </aside>

  <!-- ====================================================================
       MOBILE CONVERSION DOCK (Sticky Bottom Action Bar on Scroll)
       ==================================================================== -->
  <aside class="mobile-sticky-dock" id="mobileStickyDock" aria-label="Quick Booking Actions">
    <div class="mobile-sticky-dock__inner">
      <div class="mobile-sticky-dock__info">
        <div class="mobile-sticky-dock__price">From <strong>&#8377;799</strong><small>/mo</small></div>
        <div class="mobile-sticky-dock__rating"><i class="ph-fill ph-star"></i> 4.9 (2,400+ reviews)</div>
      </div>
      <div class="mobile-sticky-dock__actions">
        <a href="https://wa.me/919876543210?text=Hi%20V-DESK,%20I%20need%20a%20workspace%20quote" target="_blank" rel="noopener" class="btn-dock-whatsapp" aria-label="Chat on WhatsApp">
          <i class="ph-bold ph-whatsapp-logo"></i>
        </a>
        <button class="btn btn--primary btn--sm btn-dock-quote" onclick="openQuoteModal('Mobile Sticky Dock')">
          <i class="ph-bold ph-paper-plane-tilt"></i> Get Quote
        </button>
      </div>
    </div>
  </aside>

  <!-- Scroll-to-Top Button -->
  <button id="scrollTopBtn" class="scroll-top-btn" aria-label="Scroll to top">
    <i class="ph-bold ph-arrow-up"></i>
  </button>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="toast-container" aria-live="polite">
    <div id="toastStack" style="display:contents;"></div>
  </div>

  <!-- GSAP & ScrollTrigger Core (RMC Video Scroll Engine) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- Application Interaction Logic -->
  <script src="app.js"></script>
