// AUTO-INITIALIZE 2026 TRENDING FEATURES ON DOM LOAD
// ==========================================================================
function initLatestFeatures() {
  initScrollProgressBar();
  initSpotlightCards();
  initMetricCounters();
  initCommandPalette();
  initMobileStickyBar();
  initWizard();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initLatestFeatures);
} else {
  initLatestFeatures();
}
