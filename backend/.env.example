# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=5000
# Must be a replica set for atomic writes + events (Atlas is). Local single-node replica set: append ?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/vdesk
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Temporary staff key (header: x-admin-key) with full staff access, until the admin console signs in with JWT.
# At least 16 characters.
# Leave empty to disable staff endpoints (they answer 503).
ADMIN_API_KEY=
# Staff sign-in (identity). Both at least 32 random characters; leave empty to disable /api/v1/auth (503).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
MFA_ENCRYPTION_KEY=
# Number of proxies in front of the API (e.g. 1 behind Cloudflare/a load balancer) so rate limits see real IPs.
TRUST_PROXY=0
# Cloudflare Turnstile secret for public forms (POST /leads). Empty = CAPTCHA check off (local, until the site sends tokens).
TURNSTILE_SECRET_KEY=
# Internal inbox for new-lead alerts (notification template lead.sales_alert). Empty = no alert.
SALES_ALERT_EMAIL=
# Public website address for sitemap.xml links (e.g. https://vdesk.in). Empty = sitemap answers 503.
SITE_URL=
# Object storage for KYC documents. 'memory' = in-process development/test adapter (no real uploads; ignored in
# production). Empty = KYC uploads answer 503. A real S3/R2 adapter is not built yet.
STORAGE_DRIVER=
