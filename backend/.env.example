# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vdesk
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Temporary staff key for /api/v1/leads admin endpoints (header: x-admin-key). At least 16 characters.
# Leave empty to disable staff endpoints (they answer 503).
ADMIN_API_KEY=
