{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vdesk-api",
  "main": "src/cloudflare/entry.js",
  "compatibility_date": "2026-10-05",
  // nodejs_compat gives the Worker node:crypto, node:buffer and the rest the API uses, and (from the
  // compatibility date) populates process.env from the vars and secrets below — which is how
  // src/config/env.js reads its settings here, exactly as it does on a server.
  "compatibility_flags": ["nodejs_compat"],

  // Neon, through Hyperdrive: it keeps the connection pool, so this Worker opens a connection per use
  // (src/config/db.js). `wrangler hyperdrive create vdesk-neon --connection-string=…` made this id.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e75840b9e3344a23853c39e6d8ff3322",
    },
  ],

  // The background jobs src/worker.js runs in a loop (ADR-008). A Worker cannot hold a loop, so: every
  // minute for the outbox and the message queue, hourly for the row purge (ADR-011).
  "triggers": {
    "crons": ["* * * * *", "0 * * * *"],
  },

  "vars": {
    // Without this the API behaves as a development server: it would leave `Secure` off the refresh cookies.
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    // Rate limits must see the visitor's address, not Cloudflare's.
    "TRUST_PROXY": "1",
    // Set to the deployed site once it has a domain; sitemap.xml needs it.
    "SITE_URL": "https://vdesk.shoaibk-mca2024.workers.dev",
    "CORS_ORIGINS": "https://vdesk.shoaibk-mca2024.workers.dev,http://localhost:5173,http://localhost:4173",

    // ── Not set yet; the product works without them, but two things stay switched off. ──
    //
    // 1. Email delivery. Confirmations and sales alerts queue and wait until BOTH of these exist:
    //      "MAIL_FROM": "V-DESK <hello@your-verified-domain>"   ← add here, it is not a secret
    //      npx wrangler secret put RESEND_API_KEY               ← never put the key in this file
    //    The From domain has to be verified with the provider first, or every send is rejected.
    //
    // 2. "Continue with Google" at checkout. Until GOOGLE_CLIENT_ID is set, POST /auth/google answers 503
    //    and customers cannot pay. It is public, not a secret, and must be the same value the website is
    //    built with (frontend/.env.production → VITE_GOOGLE_CLIENT_ID):
    //      "GOOGLE_CLIENT_ID": "....apps.googleusercontent.com"
    //
    // A third, optional: "SALES_ALERT_EMAIL": "sales@…" turns on the internal new-enquiry alert.
    // "Continue with Google" for customers (ADR-012): add the OAuth client ID here once it exists — it is public,
    // and the same value as the website's VITE_GOOGLE_CLIENT_ID. Until then POST /auth/google answers 503.
    // "GOOGLE_CLIENT_ID": "….apps.googleusercontent.com",
  },

  // JWT_SECRET and ADMIN_API_KEY are secrets, not vars:
  //   npx wrangler secret put JWT_SECRET
  "observability": {
    "enabled": true,
  },
}
