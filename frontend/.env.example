# Copy to .env when hosting under a sub-path, e.g. GitHub Pages: /V-DESK-Workspace/
VITE_BASE_PATH=/

# Base URL of the V-DESK API for local development, e.g. http://localhost:5000/api/v1 (leave empty to
# run on the built-in local data). Production builds ignore this and use .env.production.
VITE_API_URL=
