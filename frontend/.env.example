# Copy to .env when hosting under a sub-path, e.g. GitHub Pages: /V-DESK-Workspace/
VITE_BASE_PATH=/

# Base URL of the V-DESK API for local development, e.g. http://localhost:5000/api/v1 (leave empty to
# run on the built-in local data). Production builds ignore this and use .env.production.
VITE_API_URL=

# OAuth client ID for "Continue with Google" at checkout (ADR-012) — public, not a secret. Create it in Google Cloud
# Console → APIs & Services → Credentials → OAuth client ID (Web application), with this site's address under
# "Authorised JavaScript origins". The API needs the same value as GOOGLE_CLIENT_ID. Empty = checkout explains that
# online payment is not available yet.
VITE_GOOGLE_CLIENT_ID=
