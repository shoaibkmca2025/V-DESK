# Used by every production build (`npm run build`). A mode file like this one takes priority over a personal
# .env.local, so a local development address can no longer leak into the live site. When the API moves to its own
# domain, change it here and redeploy. The build refuses non-https, local or private addresses
# (scripts/check-api-url.js).
VITE_API_URL=https://vdesk-api.shoaibk-mca2024.workers.dev/api/v1

# "Continue with Google" at checkout (ADR-012). Public, not a secret — the same value as the API's GOOGLE_CLIENT_ID.
# Until it is set, checkout says online payment is not available yet. Uncomment and fill in once the owner has
# created the OAuth client (docs/deployment.md).
# VITE_GOOGLE_CLIENT_ID=….apps.googleusercontent.com
